{
  "name": "professor-personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:standard": "next dev",
    "build": "prisma generate && prisma migrate deploy && (node prisma/seed.mjs || echo 'seed skipped') && next build",
    "postinstall": "prisma generate",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "backup": "node scripts/backup-data.mjs",
    "restore": "node scripts/restore-data.mjs",
    "test:cron": "node scripts/test-cron.mjs",
    "test:dedup": "node scripts/test-deduplication.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-aria/ssr": "^3.9.4",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.3",
    "dayjs": "^1.11.11",
    "google-auth-library": "^9.10.0",
    "googleapis": "^140.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^23.11.5",
    "iron-session": "^8.0.4",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "next-i18next": "^15.3.0",
    "nodemailer": "^8.0.7",
    "openai": "^4.52.0",
    "otplib": "^13.4.0",
    "pdf-parse": "^2.4.5",
    "peerjs": "^1.5.4",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.3",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^14.1.2",
    "react-markdown": "^9.0.1",
    "react-player": "^2.16.0",
    "recharts": "^2.12.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "stripe": "^15.8.0",
    "twilio": "^5.1.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }

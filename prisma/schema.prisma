  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String // reunion, networking, seminar
  rsvpUrl     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// PHASE 8: GRANT FUNDING TRACKER
// ═══════════════════════════════════════════════════════════════

model FundingOpportunity {
  id           String   @id @default(uuid())
  title        String
  organization String
  amount       String
  deadline     DateTime
  eligibility  String?
  focus        String? // research area
  url          String?
  status       String   @default("open") // open, closed
  notified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GrantApplication {
  id              String    @id @default(uuid())
  opportunityId   String?
  title           String
  piName          String
  coInvestigators Json? // array of names
  amount          String
  deadline        DateTime?
  status          String    @default("draft") // draft, submitted, under_review, awarded, rejected
  submittedAt     DateTime?
  decisionDate    DateTime?
  documents       Json? // array of {name, url}
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GrantBudget {
  id            String   @id @default(uuid())
  applicationId String
  items         Json // array of {category, description, amount}
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


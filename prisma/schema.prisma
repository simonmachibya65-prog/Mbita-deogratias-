// ═══════════════════════════════════════════════════════════════
// PHASE 15: MULTI-LANGUAGE SUPPORT
// ═══════════════════════════════════════════════════════════════

model Translation {
  id        String   @id @default(uuid())
  key       String
  language  String // en, sw, fr, etc
  value     String
  category  String? // ui, content, email
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language])
}

model ContentTranslation {
  id               String   @id @default(uuid())
  contentType      String // publication, course, blog_post
  contentId        String
  language         String
  translatedFields Json // {field: translatedValue}
  status           String   @default("draft") // draft, published
  translatedBy     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([contentType, contentId, language])
}


model ResearchData {
  id          String   @id @default(uuid())
  projectId   String?
  title       String
  description String?
  dataUrl     String
  format      String? // CSV, JSON, HDF5, etc
  size        String?
  accessLevel String   @default("private") // public, private, restricted
  doi         String?
  version     String   @default("1.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LabNotebook {
  id          String   @id @default(uuid())
  projectId   String?
  date        DateTime @default(now())
  title       String
  content     String
  tags        Json?
  attachments Json? // array of file URLs
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experiment {
  id          String   @id @default(uuid())
  notebookId  String?
  title       String
  hypothesis  String?
  methodology String?
  results     String?
  conclusions String?
  dataFiles   Json?
  status      String   @default("planning") // planning, running, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EquipmentBooking {
  id        String   @id @default(uuid())
  equipment String
  userId    String
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    String   @default("pending") // pending, confirmed, cancelled
  createdAt DateTime @default(now())
}


generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  Int       @id @default(1)
  fullName            String
  title               String
  department          String
  institution         String
  email               String
  officeLocation      String
  officeHours         String
  bio                 String
  photoUrl            String    @default("")
  cvUrl               String    @default("")
  // ── Per-location photos (each can be uploaded separately) ──
  navbarPhotoUrl      String    @default("") // Navbar top bar (40px circle)
  heroPhotoUrl        String    @default("") // Homepage hero (220px circle)
  aboutPhotoUrl       String    @default("") // About page (200px circle)
  contactPhotoUrl     String    @default("") // Contact page (150px circle)
  footerPhotoUrl      String    @default("") // Footer (48px circle)
  adminPhotoUrl       String    @default("") // Admin panel sidebar & dropdown
  academicProfiles    Json
  // About page enhancements
  vision              String?
  mission             String?
  skills              Json?
  languages           Json?
  education           Json?
  workExperience      Json?
  certifications      Json?
  memberships         Json?
  videoIntroUrl       String?
  // Contact enhancements
  whatsapp            String?
  mapEmbedUrl         String?
  buildingImageUrl    String?
  faq                 Json?
  // New fields
  leadershipPositions Json? // Leadership positions
  mediaAppearances    Json? // Media appearances/press
  emergencyContact    String? // Emergency contact info
  // Auto-sync settings
  autoSyncEnabled     Boolean   @default(true) // Enable/disable auto-sync
  lastSyncAt          DateTime? // Last sync timestamp
  updatedAt           DateTime  @updatedAt
}

// Connected Academic Accounts for Auto-Sync
model ConnectedAccount {
  id           String    @id @default(cuid())
  platform     String // google-scholar, orcid, researchgate, github, etc.
  accountId    String // External account ID or username
  accessToken  String? // OAuth token (encrypted)
  refreshToken String? // OAuth refresh token (encrypted)
  apiKey       String? // API key if applicable
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  syncStatus   String    @default("pending") // pending, syncing, success, error
  syncError    String? // Error message if sync failed
  metadata     Json? // Platform-specific settings
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([platform, accountId])
  @@index([platform, isActive])
}

// Auto-Synced Content Cache
model SyncedContent {
  id            String    @id @default(cuid())
  platform      String // Source platform
  externalId    String // ID from external platform
  contentType   String // publication, research, course, etc.
  title         String
  content       String    @db.Text
  metadata      Json // All extracted data
  authors       String[] // Array of authors
  publishedDate DateTime?
  citations     Int       @default(0)
  url           String?
  importedToDb  Boolean   @default(false) // Whether imported to main tables
  lastFetchedAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, externalId])
  @@index([platform, contentType])
  @@index([importedToDb])
}

model Publication {
  id         String          @id @default(uuid())
  title      String
  authors    Json
  venue      String
  year       Int
  type       PublicationType
  doi        String?
  url        String?
  abstract   String?
  pdfUrl     String?
  coverImage String?
  published  Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

enum PublicationType {
  journal
  conference
  book
  book_chapter
  technical_report
  other
}

model ResearchProject {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  description    String
  status         ProjectStatus
  startYear      Int
  endYear        Int?

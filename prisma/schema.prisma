}

model OAuthToken {
  id           String    @id @default(uuid())
  userId       String
  provider     String // google, microsoft, github
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


model Integration {
  id        String    @id @default(uuid())
  name      String // google, microsoft, zoom, github, etc
  type      String // oauth, api_key, webhook
  config    Json // credentials and settings (encrypted)
  active    Boolean   @default(false)
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SyncLog {
  id            String   @id @default(uuid())
  integrationId String
  syncType      String // publications, calendar, etc
  status        String // success, failed, partial
  itemsSync     Int?
  errorMessage  String?

  documents      Json?
  milestones     Json?
  tags           Json?
  published      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum ProjectStatus {
  active
  completed
}

model Course {
  id           String       @id @default(uuid())
